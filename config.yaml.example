doc_dirs:
  - ./docs

embeddings:
  enabled: true            # false = keyword-only search, no torch
  model: "ibm-granite/granite-embedding-english-r2"   # or "BAAI/bge-small-en-v1.5": ~5x faster to embed
  device: "cpu"
  batch_size: 32
  # query_prefix: ""       # default: the model's retrieval prefix (BGE: "Represent this sentence...")
  max_seq_length: 512     # truncate chunks; null = the model's own limit

llm_fallback:
  enabled: false
  provider: "openrouter"
  api_key_env: "OPENROUTER_API_KEY"
  model: "anthropic/claude-3-haiku"
  cache_results: true

chunking:
  target_size: 1000
  overlap: 100
  preserve_tables: true

search:
  keyword_weight: 0.5     # reciprocal-rank-fusion weights
  semantic_weight: 0.5
  top_k_default: 5
  rerank: false           # cross-encoder over the top rerank_depth sections
  rerank_model: "cross-encoder/ms-marco-MiniLM-L6-v2"
  rerank_depth: 20

index:
  directory: "./index"
  vector_file: "vectors.faiss"
  metadata_db: "metadata.db"
  documents_file: "documents.json"